{
  "manifest_version": 3,
  "name": "PrivatePilot",
  "version": "0.1.0",
  "description": "A local privacy layer for browser AI demonstrations.",
  "permissions": ["activeTab", "sidePanel", "scripting"],
  "host_permissions": ["http://localhost:3000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open PrivatePilot"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [{
    "resources": ["vendor/tesseract/worker.min.js", "vendor/tesseract/core/*", "vendor/tesseract/lang/*"],
    "matches": ["http://*/*", "https://*/*"]
  }]
}
